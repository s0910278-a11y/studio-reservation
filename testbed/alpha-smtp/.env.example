# Configure only on a NEW, separate Netlify test project. Functions scope.
# SMTP_PASSWORD and SMTP_TEST_TOKEN must be marked secret. Never commit values.
SMTP_TEST_ENABLED=false
SMTP_TEST_SITE_ID=
SMTP_PRODUCTION_SITE_ID=
SMTP_FROM=
SMTP_TEST_RUN_ID=
SMTP_TEST_TOKEN=
SMTP_TEST_RECIPIENT=
SMTP_TEST_BASE_URL=
# alpha-mail: sauth.alpha-mail.jp / username = full email address
# alpha-premier: smtp.alpha-prm.jp / username = local-part%domain
SMTP_PROVIDER=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Explicit business choice required. No implicit reply-to change.
SMTP_REPLY_TO=
